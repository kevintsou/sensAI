{
  "name": "sensai",
  "displayName": "sensAI",
  "description": "AI code review for ARM / Andes firmware C and assembly, on save",
  "version": "0.7.1",
  "publisher": "sensai",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#102A43",
    "theme": "dark"
  },
  "keywords": [
    "firmware",
    "embedded",
    "code review",
    "ARM",
    "RISC-V",
    "Andes",
    "AI",
    "assembly"
  ],
  "homepage": "https://github.com/kevintsou/sensAI",
  "bugs": {
    "url": "https://github.com/kevintsou/sensAI/issues"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sensai.reviewCurrentFile",
        "title": "sensAI: Review Current File",
        "icon": "$(search)"
      },
      {
        "command": "sensai.showPanel",
        "title": "sensAI: Show Findings"
      },
      {
        "command": "sensai.initProject",
        "title": "sensAI: Initialize Project"
      },
      {
        "command": "sensai.exportFalsePositives",
        "title": "sensAI: Export False Positive Report"
      },
      {
        "command": "sensai.clearLocalMutes",
        "title": "sensAI: Clear Local Mutes"
      },
      {
        "command": "sensai.reloadRules",
        "title": "sensAI: Reload Rules"
      },
      {
        "command": "sensai.cancelReview",
        "title": "sensAI: Cancel Review"
      },
      {
        "command": "sensai.clearPins",
        "title": "sensAI: Clear Pinned Findings"
      },
      {
        "command": "sensai.toggle",
        "title": "sensAI: Toggle On/Off"
      },
      {
        "command": "sensai.enable",
        "title": "sensAI: Enable"
      },
      {
        "command": "sensai.disable",
        "title": "sensAI: Disable Temporarily"
      },
      {
        "command": "sensai.reviewChanges",
        "title": "sensAI: Review Changes (Manual Mode)",
        "icon": "$(play)"
      },
      {
        "command": "sensai.pickMode",
        "title": "sensAI: Switch Mode (Auto / Manual / Off)"
      },
      {
        "command": "sensai.modeMenu.auto",
        "title": "sensAI 模式：自動（點選切換）",
        "icon": "$(eye)"
      },
      {
        "command": "sensai.modeMenu.manual",
        "title": "sensAI 模式：手動（點選切換）",
        "icon": "$(debug-pause)"
      },
      {
        "command": "sensai.modeMenu.off",
        "title": "sensAI 模式：已關閉（點選切換）",
        "icon": "$(eye-closed)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sensai.reviewCurrentFile",
          "when": "config.sensai.enabled && resourceExtname =~ /\\.(c|h|s|S)$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "sensai.reviewChanges",
          "when": "view == sensai.findings && config.sensai.enabled && config.sensai.mode == 'manual'",
          "group": "navigation@1"
        },
        {
          "command": "sensai.modeMenu.auto",
          "when": "view == sensai.findings && config.sensai.enabled && config.sensai.mode != 'manual'",
          "group": "navigation@2"
        },
        {
          "command": "sensai.modeMenu.manual",
          "when": "view == sensai.findings && config.sensai.enabled && config.sensai.mode == 'manual'",
          "group": "navigation@2"
        },
        {
          "command": "sensai.modeMenu.off",
          "when": "view == sensai.findings && !config.sensai.enabled",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "sensai.reviewChanges",
          "when": "config.sensai.enabled && config.sensai.mode == 'manual'"
        },
        {
          "command": "sensai.modeMenu.auto",
          "when": "false"
        },
        {
          "command": "sensai.modeMenu.manual",
          "when": "false"
        },
        {
          "command": "sensai.modeMenu.off",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sensai",
          "title": "sensAI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sensai": [
        {
          "id": "sensai.findings",
          "name": "Findings",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "sensAI",
      "properties": {
        "sensai.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "sensAI 總開關。關閉後不會送出任何審查，`sensAI: Review Current File` 也不例外；面板、釘選與筆記仍可檢視。開啟時依 `sensai.mode` 決定什麼時候審查。可用 sensAI 側欄標題列或狀態列的模式按鈕切換。"
        },
        "sensai.mode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "enumDescriptions": [
            "自動：存檔就審查改動的地方。",
            "手動：存檔不審查。改完一組後按 ▶ 審查改動（側欄標題列或狀態列），把相對 git HEAD 改過的檔案整組送審，可以跨多個檔案。"
          ],
          "default": "auto",
          "markdownDescription": "什麼時候審查（`sensai.enabled` 開啟時）。`auto` 存檔就審查；`manual` 存檔不審查，改完一組後按 **▶ 審查改動**，把相對 git HEAD 改過的 C／組語檔案整組送審，模型看得到跨檔案的不一致。`sensAI: Review Current File` 兩種模式都可以用。"
        },
        "sensai.debounceMs": {
          "type": "number",
          "default": 1000,
          "markdownDescription": "存檔後等待多久（毫秒）沒有新的存檔才送出審查。避免連續存檔一直送出重複請求。設 0 代表存檔立即審查。`sensAI: Review Current File` 不受影響。"
        },
        "sensai.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:3456",
          "description": "Claude Code Router 的位址。"
        },
        "sensai.model": {
          "type": "string",
          "default": "claude-opus-5",
          "description": "送給 CCR 的 model 欄位，實際上是路由 key。"
        },
        "sensai.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "送給 endpoint 的 API key（放在 `Authorization: Bearer` 標頭）。新版 Claude Code Router 需要它；舊版不驗證可留空。\n\n**安全提醒：** 這是機密。建議填在**使用者設定（User Settings）**而非專案的 `.vscode/settings.json`，以免被 commit 進版控或被 Settings Sync 同步出去。留空時會改讀環境變數 `ANTHROPIC_API_KEY`。"
        },
        "sensai.rulesPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "規則檔路徑。留空時使用工作區的 .sensai/rules.yaml；相對路徑以工作區根目錄為準。"
        },
        "sensai.includeDepth": {
          "type": "number",
          "default": 2,
          "description": "解析 #include \"...\" 的遞迴深度。"
        },
        "sensai.contextBudgetBytes": {
          "type": "number",
          "default": 120000,
          "description": "附帶 header 的總位元組上限。"
        },
        "sensai.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "單次審查的逾時毫秒數。"
        },
        "sensai.maxFindings": {
          "type": "number",
          "default": 8,
          "description": "面板上最多直接顯示幾則意見。超過的話，較低嚴重度的會收合到「另有 N 則」裡（error 永遠不收）。設 0 表示不限制。"
        },
        "sensai.reviewWholeFile": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "預設審查範圍是「改動的行」加上「改動所在的函式」。開啟後，額外再審**整份檔案**，能抓到不在改動函式裡的問題（例如別處的宣告、跨函式的慣例），代價是多送一次請求、較慢也較耗 token。"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "watch": "npm run build -- --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "pretest": "npm run compile",
    "compile": "tsc --outDir out",
    "prereview": "npm run compile",
    "review": "node scripts/review.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --out sensai.vsix",
    "mock": "node scripts/mock-router.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "minimatch": "^10.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "@vscode/vsce": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kevintsou/sensAI.git"
  }
}
